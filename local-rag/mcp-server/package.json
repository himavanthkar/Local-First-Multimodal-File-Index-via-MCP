{
  "name": "obi-mcp-server",
  "version": "0.1.0",
  "description": "Standalone MCP (Model Context Protocol) server that exposes Obi's local file/code/PDF index over stdio so Cursor (and other MCP clients) can pull retrieval context on demand.",
  "private": true,
  "type": "module",
  "bin": {
    "obi-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "better-sqlite3": "^12.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3"
  }
}
